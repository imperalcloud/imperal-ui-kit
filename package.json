{
  "name": "@imperal/ui-kit",
  "version": "0.2.0",
  "description": "Imperal declarative UINode -> React renderer — the same UI components the Imperal Panel uses.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "styles.d.ts"
  ],
  "scripts": {
    "build": "tsup && npx @tailwindcss/cli -i src/styles.css -o dist/styles.css --content './src/**/*.{ts,tsx}' && node scripts/scope-css.mjs",
    "build:css": "npx @tailwindcss/cli -i src/styles.css -o dist/styles.css --content './src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run contract:check && npm test && npm run build && node examples/render-check.mjs --strict && npm audit && npm run check:packed",
    "contract:check": "node scripts/check-contract.mjs",
    "check:packed": "node scripts/check-packed-consumer.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@imperal/design-tokens": "file:../imperal-design-tokens",
    "@tailwindcss/cli": "^4",
    "@tailwindcss/typography": "^0.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.15",
    "postcss-prefixwrap": "^1.58.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imperalcloud/imperal-ui-kit.git"
  },
  "license": "UNLICENSED",
  "keywords": [
    "imperal",
    "ui",
    "declarative",
    "react",
    "renderer",
    "ui-kit"
  ],
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2",
    "cytoscape": "^3.33.2",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dompurify": "3.4.12",
    "lucide-react": "^0.468.0",
    "react-cytoscapejs": "^2.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "16.1.1",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
